# Development/demo: keep true until the real Career Workflow Runtime is deployed.
MOCK_MODE=true

# Optional protection for the public MCP endpoint.
# If set, configure TBox Header Authorization = Bearer <same-value>
MCP_BEARER_TOKEN=

# Production Runtime adapter (required when MOCK_MODE=false)
CAREER_RUNTIME_BASE_URL=
CAREER_RUNTIME_TOKEN=

# Development-only actor injection. Do not use model-provided actor identity.
CAREER_DEV_ACTOR_ID=
