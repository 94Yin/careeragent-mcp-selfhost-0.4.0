# Load these into the process explicitly; server does not automatically read .env.
MOCK_MODE=false
HOST=127.0.0.1
PORT=3000
CAREER_RUNTIME_BASE_URL=http://127.0.0.1:8080/api/v1
CAREER_RUNTIME_TIMEOUT_MS=10000
# Controlled local integration only; rejected in production.
MCP_ENVIRONMENT=TEST
MCP_IDENTITY_MODE=TEST_LOCAL
CAREER_RUNTIME_JWKS_URL=http://127.0.0.1:19090/.well-known/jwks.json
CAREER_RUNTIME_TOKEN=
MCP_BEARER_TOKEN=
